

model Product {
  id              String         @id @default(uuid(7))
  categoryId      String
  brandId         String?
  approvalStatus  ApprovalStatus @default(APPROVED)
  title           String         @unique
  slug            String         @unique
  description     String?
  costPrice       Float
  originalPrice   Float //Regular Price
  sellingPrice    Float
  isDiscounted    Boolean        @default(false)
  discountType    DiscountType?
  discountValue   Float?         @default(0.0)
  discountExpires DateTime?
  stock           Int            @default(0)
  unit            ProductUnit
  unitValue       Float?
  supplierName    String?
  invoiceNo       String?
  isAvailable     Boolean        @default(true)
  isDeleted       Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id])
  brand      Brand?         @relation(fields: [brandId], references: [id])
  images     ProductImage[]
  orderItems OrderItem[]
  review     Review[]
  wishlist   Wishlist[]
  purchases  Purchase[]

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

